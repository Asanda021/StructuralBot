"""
StructuralBot calculation engine.

This module provides the central calculation-engine interface.

Important architecture rule:
    UI / Telegram
            ↓
    Calculation Engine
            ↓
    Design Code
            ↓
    Member Calculation
            ↓
    Detailing / Reinforcement
            ↓
    BBS / Cut List / Quantities

This file is intentionally NOT responsible for:
- Telegram UI
- Database
- PDF / Excel
- Localization
- User interaction
- Hard-coded design-code rules

Design-code-specific rules belong inside the `codes/` package.
Member-specific calculations will be implemented in dedicated
modules and registered with this engine.
"""

from __future__ import annotations

from abc import ABC, abstractmethod
from dataclasses import dataclass, field
from typing import (
    Any,
    Callable,
    Dict,
    Iterable,
    List,
    Optional,
    Type,
)

from core.models import (
    CalculationResult,
    CalculationStatus,
    EngineeringContext,
    StructuralMember,
    StructureType,
)
from core.validation import (
    ValidationResult,
    validate_member_data,
)


# ============================================================
# TYPES
# ============================================================


CalculationFunction = Callable[
    [
        StructuralMember,
        EngineeringContext,
    ],
    CalculationResult,
]


# ============================================================
# CALCULATION EXCEPTION
# ============================================================


class CalculationError(Exception):
    """
    Base exception for calculation-engine errors.
    """

    pass


class UnsupportedCalculationError(CalculationError):
    """
    Raised when a requested member calculation is not registered.
    """

    pass


class UnsupportedStructureTypeError(CalculationError):
    """
    Raised when the selected structure type is not supported.
    """

    pass


class CalculationValidationError(CalculationError):
    """
    Raised when calculation input validation fails.
    """

    def __init__(
        self,
        message: str,
        validation_result: Optional[
            ValidationResult
        ] = None,
    ) -> None:
        super().__init__(message)
        self.validation_result = validation_result


# ============================================================
# CALCULATION REQUEST
# ============================================================


@dataclass
class CalculationRequest:
    """
    Standard request sent to the calculation engine.

    The request contains:
    - structural member
    - engineering context
    - optional calculation options
    """

    member: StructuralMember

    context: EngineeringContext

    options: Dict[str, Any] = field(
        default_factory=dict
    )

    def to_dict(self) -> Dict[str, Any]:
        return {
            "member": self.member.to_dict(),
            "context": self.context.to_dict(),
            "options": self.options,
        }


# ============================================================
# CALCULATION MODULE INTERFACE
# ============================================================


class CalculationModule(ABC):
    """
    Base interface for all structural calculation modules.

    Examples:
        ConcreteColumnCalculation
        ConcreteBeamCalculation
        ConcreteFoundationCalculation
        ConcreteSlabCalculation

    Later:
        SteelColumnCalculation
        SteelBeamCalculation
        CompositeBeamCalculation
        ...
    """

    name: str = ""
    member_type: str = ""
    structure_type: StructureType = StructureType.CONCRETE

    @abstractmethod
    def validate(
        self,
        member: StructuralMember,
        context: EngineeringContext,
    ) -> ValidationResult:
        """
        Validate inputs before calculation.
        """

        raise NotImplementedError

    @abstractmethod
    def calculate(
        self,
        member: StructuralMember,
        context: EngineeringContext,
    ) -> CalculationResult:
        """
        Perform the actual engineering calculation.
        """

        raise NotImplementedError


# ============================================================
# FUNCTION-BASED MODULE ADAPTER
# ============================================================


@dataclass
class FunctionCalculationModule(
    CalculationModule
):
    """
    Adapter that allows a simple calculation function
    to be registered as a calculation module.

    Useful for smaller calculation components and
    transitional development stages.
    """

    name: str

    member_type: str

    structure_type: StructureType

    calculation_function: CalculationFunction

    validation_function: Optional[
        Callable[
            [
                StructuralMember,
                EngineeringContext,
            ],
            ValidationResult,
        ]
    ] = None

    def validate(
        self,
        member: StructuralMember,
        context: EngineeringContext,
    ) -> ValidationResult:
        if self.validation_function:
            return self.validation_function(
                member,
                context,
            )

        return validate_member_data(
            member.to_dict()
        )

    def calculate(
        self,
        member: StructuralMember,
        context: EngineeringContext,
    ) -> CalculationResult:
        return self.calculation_function(
            member,
            context,
        )


# ============================================================
# CALCULATION REGISTRY
# ============================================================


class CalculationRegistry:
    """
    Central registry of available calculation modules.

    Registry key:
        (structure_type, member_type, calculation_name)

    Example:
        ("concrete", "beam", "flexure")

    This prevents the bot from containing engineering logic.
    """

    def __init__(self) -> None:
        self._modules: Dict[
            tuple[str, str, str],
            CalculationModule,
        ] = {}

    @staticmethod
    def _normalize_structure_type(
        structure_type: StructureType | str,
    ) -> str:
        if isinstance(
            structure_type,
            StructureType,
        ):
            return structure_type.value

        return str(structure_type).strip().lower()

    @staticmethod
    def _normalize(
        value: Any,
    ) -> str:
        return str(value).strip().lower()

    def register(
        self,
        module: CalculationModule,
    ) -> None:
        """
        Register a calculation module.
        """

        if not module.name:
            raise ValueError(
                "Calculation module name cannot be empty."
            )

        if not module.member_type:
            raise ValueError(
                "Calculation module member_type cannot be empty."
            )

        key = (
            self._normalize_structure_type(
                module.structure_type
            ),
            self._normalize(
                module.member_type
            ),
            self._normalize(
                module.name
            ),
        )

        self._modules[key] = module

    def unregister(
        self,
        structure_type: StructureType | str,
        member_type: str,
        calculation_name: str,
    ) -> None:
        key = (
            self._normalize_structure_type(
                structure_type
            ),
            self._normalize(member_type),
            self._normalize(calculation_name),
        )

        self._modules.pop(
            key,
            None,
        )

    def get(
        self,
        structure_type: StructureType | str,
        member_type: str,
        calculation_name: str,
    ) -> CalculationModule:
        """
        Retrieve a registered calculation module.
        """

        key = (
            self._normalize_structure_type(
                structure_type
            ),
            self._normalize(member_type),
            self._normalize(calculation_name),
        )

        module = self._modules.get(key)

        if module is None:
            raise UnsupportedCalculationError(
                "No calculation module registered for "
                f"{structure_type}/{member_type}/"
                f"{calculation_name}."
            )

        return module

    def exists(
        self,
        structure_type: StructureType | str,
        member_type: str,
        calculation_name: str,
    ) -> bool:
        key = (
            self._normalize_structure_type(
                structure_type
            ),
            self._normalize(member_type),
            self._normalize(calculation_name),
        )

        return key in self._modules

    def list_modules(self) -> List[str]:
        """
        Return registered calculation keys.
        """

        return [
            f"{structure}/{member}/{name}"
            for structure, member, name
            in sorted(self._modules.keys())
        ]

    def list_for_member(
        self,
        structure_type: StructureType | str,
        member_type: str,
    ) -> List[str]:
        """
        Return calculation names available for a member.
        """

        structure = self._normalize_structure_type(
            structure_type
        )

        member = self._normalize(
            member_type
        )

        return [
            name
            for (
                module_structure,
                module_member,
                name,
            ) in sorted(self._modules.keys())
            if (
                module_structure == structure
                and module_member == member
            )
        ]


# ============================================================
# CALCULATION ENGINE
# ============================================================


class CalculationEngine:
    """
    Main calculation-engine coordinator.

    The engine:
        1. Validates the request.
        2. Finds the correct calculation module.
        3. Executes the module.
        4. Normalizes the result.
        5. Returns a CalculationResult.

    It does not know how Telegram works.
    """

    def __init__(
        self,
        registry: Optional[
            CalculationRegistry
        ] = None,
    ) -> None:

        self.registry = (
            registry
            if registry is not None
            else CalculationRegistry()
        )

    def register_module(
        self,
        module: CalculationModule,
    ) -> None:
        """
        Register a calculation module.
        """

        self.registry.register(
            module
        )

    def validate_request(
        self,
        request: CalculationRequest,
    ) -> ValidationResult:
        """
        Validate a calculation request.
        """

        errors: List[str] = []
        warnings: List[str] = []

        member_result = self._validate_member(
            request.member
        )

        errors.extend(
            member_result.errors
        )

        warnings.extend(
            member_result.warnings
        )

        if (
            request.context.structure_type
            != self._structure_type_from_member(
                request.member
            )
        ):
            # This check is intentionally warning-only for now.
            #
            # A member may later be represented generically
            # while the project structure type controls
            # the selected calculation family.
            warnings.append(
                "Member structure type and calculation "
                "context may require additional review."
            )

        result = ValidationResult(
            valid=not errors,
            errors=errors,
            warnings=warnings,
        )

        return result

    @staticmethod
    def _validate_member(
        member: StructuralMember,
    ) -> ValidationResult:
        """
        Perform generic member validation.

        Detailed validation belongs to the calculation module.
        """

        return validate_member_data(
            member.to_dict()
        )

    @staticmethod
    def _structure_type_from_member(
        member: StructuralMember,
    ) -> StructureType:
        """
        Determine a default structure type.

        The current model is primarily designed for concrete
        v1 development. Future member metadata can explicitly
        define the structure type.
        """

        value = member.metadata.get(
            "structure_type"
        )

        if value:
            try:
                return StructureType(value)
            except ValueError:
                pass

        return StructureType.CONCRETE

    def calculate(
        self,
        request: CalculationRequest,
        calculation_name: str,
    ) -> CalculationResult:
        """
        Execute one registered calculation.

        Example:
            engine.calculate(
                request,
                "flexure",
            )
        """

        validation = self.validate_request(
            request
        )

        if not validation.valid:
            raise CalculationValidationError(
                "Calculation request validation failed.",
                validation_result=validation,
            )

        structure_type = (
            request.context.structure_type
        )

        member_type = (
            request.member.member_type.value
        )

        module = self.registry.get(
            structure_type,
            member_type,
            calculation_name,
        )

        module_validation = module.validate(
            request.member,
            request.context,
        )

        if not module_validation.valid:
            raise CalculationValidationError(
                "Calculation module validation failed.",
                validation_result=module_validation,
            )

        try:
            result = module.calculate(
                request.member,
                request.context,
            )

        except CalculationError:
            raise

        except Exception as exc:
            raise CalculationError(
                "Unexpected error during calculation."
            ) from exc

        return self._normalize_result(
            result,
            request,
        )

    @staticmethod
    def _normalize_result(
        result: CalculationResult,
        request: CalculationRequest,
    ) -> CalculationResult:
        """
        Ensure common result metadata is always populated.
        """

        if result.member_id is None:
            result.member_id = (
                request.member.id
            )

        if not result.code:
            result.code = (
                request.context.design_code
            )

        if not result.code_edition:
            result.code_edition = (
                request.context.code_edition
            )

        if result.status == CalculationStatus.PENDING:
            result.status = (
                CalculationStatus.SUCCESS
            )

        return result


# ============================================================
# DEFAULT ENGINE
# ============================================================


default_registry = CalculationRegistry()

default_engine = CalculationEngine(
    registry=default_registry
)


# ============================================================
# REGISTRATION HELPERS
# ============================================================


def register_calculation(
    module: CalculationModule,
) -> None:
    """
    Register a module in the global default engine.

    Individual calculation packages can import this helper
    without creating their own engine.
    """

    default_engine.register_module(
        module
    )


def get_available_calculations(
    structure_type: StructureType | str,
    member_type: str,
) -> List[str]:
    """
    Return available calculation names for a member.
    """

    return default_engine.registry.list_for_member(
        structure_type,
        member_type,
    )


# ============================================================
# SAFE CALCULATION WRAPPER
# ============================================================


def run_calculation(
    member: StructuralMember,
    context: EngineeringContext,
    calculation_name: str,
    *,
    options: Optional[
        Dict[str, Any]
    ] = None,
) -> CalculationResult:
    """
    Convenience wrapper around the default engine.

    This is the main entry point future handlers can use.

    Example:
        result = run_calculation(
            member,
            context,
            "flexure",
        )
    """

    request = CalculationRequest(
        member=member,
        context=context,
        options=options or {},
    )

    return default_engine.calculate(
        request,
        calculation_name,
    )


# ============================================================
# CALCULATION PIPELINE
# ============================================================


class CalculationPipeline:
    """
    Multi-stage calculation pipeline.

    This allows future calculations to follow:

        Input
          ↓
        Validation
          ↓
        Main Calculation
          ↓
        Detailing
          ↓
        Reinforcement
          ↓
        BBS
          ↓
        Cut List
          ↓
        Quantities

    Stages can be added without modifying the Telegram layer.
    """

    def __init__(
        self,
        engine: CalculationEngine,
    ) -> None:

        self.engine = engine

        self._preprocessors: List[
            Callable[
                [
                    CalculationRequest,
                ],
                CalculationRequest,
            ]
        ] = []

        self._postprocessors: List[
            Callable[
                [
                    CalculationResult,
                ],
                CalculationResult,
            ]
        ] = []

    def add_preprocessor(
        self,
        processor: Callable[
            [
                CalculationRequest,
            ],
            CalculationRequest,
        ],
    ) -> None:
        self._preprocessors.append(
            processor
        )

    def add_postprocessor(
        self,
        processor: Callable[
            [
                CalculationResult,
            ],
            CalculationResult,
        ],
    ) -> None:
        self._postprocessors.append(
            processor
        )

    def run(
        self,
        request: CalculationRequest,
        calculation_name: str,
    ) -> CalculationResult:
        """
        Run the complete pipeline.
        """

        processed_request = request

        for processor in self._preprocessors:
            processed_request = processor(
                processed_request
            )

        result = self.engine.calculate(
            processed_request,
            calculation_name,
        )

        processed_result = result

        for processor in self._postprocessors:
            processed_result = processor(
                processed_result
            )

        return processed_result


default_pipeline = CalculationPipeline(
    default_engine
)


# ============================================================
# MODULE DISCOVERY
# ============================================================


def has_calculation(
    structure_type: StructureType | str,
    member_type: str,
    calculation_name: str,
) -> bool:
    """
    Check whether a calculation is currently available.
    """

    return default_engine.registry.exists(
        structure_type,
        member_type,
        calculation_name,
    )


def list_registered_modules() -> List[str]:
    """
    Return all currently registered calculation modules.
    """

    return default_engine.registry.list_modules()
